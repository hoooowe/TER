# 复制为 backend/.env 后填入两个服务各自的密钥，修改后重启后端。
# 通义 ASR（语音识别）
DASHSCOPE_API_KEY=
ALIYUN_ASR_MODEL=qwen3-asr-flash
ALIYUN_ASR_BASE_URL=https://maas.qianwenaiapi.com/api/v1

# 多模态双维编码：Kimi-K2.6 / Moonshot 中国区
# VL_BASE_URL 也可以填完整的 /chat/completions URL。
VL_PROVIDER=moonshot
VL_API_KEY=
VL_MODEL=kimi-k2.6
VL_BASE_URL=https://api.moonshot.cn/v1
VL_THINKING=disabled
# 留空时由服务商使用默认温度；Kimi 非思考模式仅接受 0.6，思考模式仅接受 1.0。
VL_TEMPERATURE=
VL_MAX_TOKENS=40960
VL_TIMEOUT_SEC=120
# Kimi 不需要现有 Omni 调用使用的 modalities 字段，留空不发送。
VL_MODALITIES=

DUAL_FRAMES_MODE=adaptive
DUAL_FRAMES_PER_UNIT=8
DUAL_CONFIDENCE_THRESHOLD=0.70
